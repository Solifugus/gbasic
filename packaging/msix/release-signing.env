# The RELEASE signing identity: Azure Artifact Signing (docs/windows_port_status.md §24).
# Read by tools/build-msix.sh when run with MSIX_SIGN=azure. None of this is
# secret -- it names an account; signing needs an `az login` by someone holding
# the Certificate Profile Signer role on it.
#
# MSIX_PUBLISHER MUST EQUAL THE SIGNING CERTIFICATE'S SUBJECT, character for
# character (the lowercase `ny` included: it is what the billing address said
# when the identity was validated), or Windows refuses the package. The build
# reads the subject back from the signed package and fails if they differ.
ARTIFACT_SIGNING_ENDPOINT="https://eus.codesigning.azure.net"
ARTIFACT_SIGNING_ACCOUNT="gbasicsigning"
ARTIFACT_SIGNING_PROFILE="gbasicrelease"
MSIX_PUBLISHER="CN=Matthew Tedder, O=Matthew Tedder, L=Fayetteville, S=ny, C=US"
MSIX_PUBLISHER_DISPLAY="Matthew Tedder"
