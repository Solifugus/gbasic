' OPENING AN `openssh-key-v1` FILE THAT ssh-keygen ENCRYPTED, in gBASIC, the
' way Transward will: bcrypt_pbkdf derives the key and IV from the passphrase
' and the file's kdfoptions, aes_ctr decrypts the private section, and the
' keys inside must be the ones ssh-keygen wrote. The end-to-end check
' Transward asked for (§2.4: "verify against keys generated by ssh-keygen -a N
' with a passphrase").
'
' THE ORACLE IS ssh-keygen: the public key in the `.pub` file it wrote beside
' each private key. An Ed25519 seed must give that public key; an RSA key's
' n and e must be the `.pub` file's, and the runner has openssl verify a
' signature made with what this program recovered.
'
' Reads ed, ed.pub, rsa, rsa.pub from $DIR; writes rsa_sig.hex.

function check(what, got, want)
    g.checks = g.checks + 1
    if string(got) = string(want) then
        print "ok   " + what
    else
        g.bad = g.bad + 1
        print "MISMATCH " + what + ": got " + string(got) + ", want " + string(want)
    end if
    return nothing
end function

' AN SSH WIRE READER. Records are values in gBASIC, so a reader cannot advance
' a position held by its caller: each read answers the value and the reader
' moved on, `{ v, r }`, and the caller keeps the new reader.
function u32(r)
    b = r.bytes
    p = r.at
    v = ((byte_at(b, p) * 256 + byte_at(b, p + 1)) * 256 + byte_at(b, p + 2)) * 256 + byte_at(b, p + 3)
    return { v: v, r: { bytes: b, at: p + 4 } }
end function

function sshstring(r)
    n = u32(r)
    return { v: byte_slice(r.bytes, n.r.at, n.v), r: { bytes: r.bytes, at: n.r.at + n.v } }
end function

' an mpint without the sign byte SSH adds when the top bit is set
function mpint(r)
    t = sshstring(r)
    if byte_count(t.v) > 1 and byte_at(t.v, 0) = 0 then
        t.v = byte_slice(t.v, 1, byte_count(t.v) - 1)
    end if
    return t
end function

function body_of(text)
    ls = []
    for each line in split(trim(text), "\n")
        if not starts_with(line, "-----") then
            append(ls, trim(line))
        end if
    end for
    return base64_decode(join(ls, ""))
end function

' the decrypted private section of an encrypted openssh-key-v1 file
function open_keyfile(text, passphrase)
    r = { bytes: body_of(text), at: 15 }
    magic = byte_slice(r.bytes, 0, 15)
    t = sshstring(r)
    cipher = t.v
    t = sshstring(t.r)
    kdf = t.v
    t = sshstring(t.r)
    opts = t.r
    o = sshstring({ bytes: t.v, at: 0 })
    salt = o.v
    rounds = u32(o.r).v
    n = u32(t.r)
    t = sshstring(n.r)
    public_blob = t.v
    t = sshstring(t.r)
    km = bcrypt_pbkdf(passphrase, salt, rounds, 48)
    plain = aes_ctr(byte_slice(km, 0, 32), byte_slice(km, 32, 16), t.v).data
    return { magic: magic, cipher: cipher, kdf: kdf, rounds: rounds, nkeys: n.v,
             public_blob: public_blob, section: { bytes: plain, at: 0 } }
end function

function pub_blob(pubtext)
    return base64_decode(split(trim(pubtext), " ")[1])
end function

g = { checks: 0, bad: 0 }
dir = env("DIR")

print "-- Ed25519, encrypted by ssh-keygen -a 16"
f = open_keyfile(read(join_path(dir, "ed")), "correct horse")
check("the file is openssh-key-v1", f.magic, "openssh-key-v1" + chr(0))
check("ciphered with aes256-ctr", f.cipher, "aes256-ctr")
check("its key derived by bcrypt", f.kdf, "bcrypt")
check("over the rounds asked for", f.rounds, 16)
t = u32(f.section)
c1 = t.v
t = u32(t.r)
check("the two check numbers agree: the passphrase opened it", c1, t.v)
t = sshstring(t.r)
check("it holds an ssh-ed25519 key", t.v, "ssh-ed25519")
t = sshstring(t.r)
pub = t.v
t = sshstring(t.r)
both = t.v
check("the public key is the .pub file's",
      pub_blob(read(join_path(dir, "ed.pub"))) = f.public_blob, true)
check("the private part is the 32-byte seed and the public key", byte_count(both), 64)
check("the seed's public half is the file's", byte_slice(both, 32, 32), pub)
sig = ed25519_sign(byte_slice(both, 0, 32), "a message")
check("a signature with the recovered seed verifies under the .pub key",
      ed25519_verify(pub, "a message", sig), true)
wrong = open_keyfile(read(join_path(dir, "ed")), "wrong horse")
w = u32(wrong.section)
check("the wrong passphrase gives check numbers that disagree", w.v = u32(w.r).v, false)

print "-- RSA, encrypted by ssh-keygen -a 8"
f = open_keyfile(read(join_path(dir, "rsa")), "correct horse")
check("ciphered with aes256-ctr", f.cipher, "aes256-ctr")
check("over the rounds asked for", f.rounds, 8)
t = u32(f.section)
c1 = t.v
t = u32(t.r)
check("the passphrase opened it", c1, t.v)
t = sshstring(t.r)
check("it holds an ssh-rsa key", t.v, "ssh-rsa")
key = {}
for each part in [ "n", "e", "d", "iqmp", "p", "q" ]
    t = mpint(t.r)
    key[part] = t.v
end for
pr = sshstring({ bytes: pub_blob(read(join_path(dir, "rsa.pub"))), at: 0 })
check("the .pub file says ssh-rsa", pr.v, "ssh-rsa")
pe = mpint(pr.r)
check("its e is the recovered e", pe.v = key.e, true)
check("its n is the recovered n", mpint(pe.r).v = key.n, true)
check("and the six parts are one key: it signs and verifies",
      rsa_verify(rsa_public(key), "a message", rsa_sign(key, "a message", "sha256"), "sha256"), true)
write(join_path(dir, "rsa_sig.hex"), hex_encode(rsa_sign(key, "a message", "sha512")))

print ""
print "checks: " + string(g.checks)
print "mismatches: " + string(g.bad)
