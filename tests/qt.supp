# THE BROADEST ENTRY, said as such: the menu bar's private sizing again (the
# same unnamed function; its value from QMenuBar's constructor), reached
# through the generic event path of a widget's first show, so nothing names
# the menu bar here. Anchored on that whole path to keep it as narrow as the
# report allows.
{
   qt-s390x-pending-resize-event-cond
   Memcheck:Cond
   obj:*/libQt6Widgets.so*
   obj:*/libQt6Widgets.so*
   fun:_ZN7QWidget5eventEP6QEvent
   fun:_ZN19QApplicationPrivate13notify_helperEP7QObjectP6QEvent
   fun:_ZN16QCoreApplication15notifyInternal2EP7QObjectP6QEvent
   fun:_ZN14QWidgetPrivate30sendPendingMoveAndResizeEventsEbb
   ...
}

# the same sizing with a second unnamed frame between (gBASIC's menu fixture
# reaches QMenuBar::sizeHint two frames down; the probe's window, one)
{
   qt-s390x-qmenubar-sizehint-deeper-cond
   Memcheck:Cond
   obj:*/libQt6Widgets.so*
   obj:*/libQt6Widgets.so*
   fun:_ZNK8QMenuBar8sizeHintEv
   ...
}

{
   qt-s390x-qmenubar-minimumsizehint-deeper-cond
   Memcheck:Cond
   obj:*/libQt6Widgets.so*
   obj:*/libQt6Widgets.so*
   fun:_ZNK8QMenuBar15minimumSizeHintEv
   ...
}

# a grid inside a box layout asks the grid which ways it expands
{
   qt-s390x-qgridlayout-expandingdirections-cond
   Memcheck:Cond
   obj:*/libQt6Widgets.so*
   fun:_ZNK11QGridLayout19expandingDirectionsEv
   ...
}

# THE GATE OF 2026-11-15 (run_qt_capture, run_qt_find, run_qt_keys,
# run_qt_chooser): four more, each reproduced by the probe with no gBASIC and
# each value's origin, by --track-origins, in QLabel's, QComboBox's or
# QFileDialog's own construction, or a local of QLineEdit::deselect.

# a label's style sheet set through setProperty
{
   qt-s390x-qwidget-setstylesheet-cond
   Memcheck:Cond
   fun:_ZN7QWidget13setStyleSheetERK7QString
   ...
}

# a combo box's popup hidden
{
   qt-s390x-qcombobox-hidepopup-cond
   Memcheck:Cond
   fun:_ZN9QComboBox9hidePopupEv
   ...
}

# a key typed into a line edit
{
   qt-s390x-qwidgetlinecontrol-internalinsert-cond
   Memcheck:Cond
   fun:_ZN18QWidgetLineControl14internalInsertERK7QString
   ...
}

# a combo box's own view told of rows inserted into its model (an item added,
# or a file dialog's history set); the receiving function has no symbol, so
# the entry names the path: a Widgets slot, Core's signal delivery, the signal
{
   qt-s390x-combobox-view-rowsinserted-cond
   Memcheck:Cond
   obj:*/libQt6Widgets.so*
   obj:*/libQt6Core.so*
   fun:_ZN18QAbstractItemModel12rowsInsertedERK11QModelIndexiiNS_14QPrivateSignalE
   ...
}

# and of data changed in that model, by the same path
{
   qt-s390x-combobox-view-datachanged-cond
   Memcheck:Cond
   obj:*/libQt6Widgets.so*
   obj:*/libQt6Core.so*
   fun:_ZN18QAbstractItemModel11dataChangedERK11QModelIndexS2_RK5QListIiE
   ...
}
