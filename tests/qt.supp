# Valgrind suppressions for defects INSIDE Qt, applied to every valgrind tier
# through tests/valgrind_tier.sh (they name Qt functions, so nothing outside Qt
# can match them).
#
# The rule is tests/odbc.supp's: each entry is reproduced with NO gBASIC in the
# stack before it is written, or a suppression is indistinguishable from hiding
# our own bug. tests/qt_valgrind_probe.cpp is that program, committed: a window
# built as gBASIC builds one, and nothing else.
#
# ON THE s390x VM (Debian 13, Qt 6.8.2), 2026-11-14, valgrind reported
# "Conditional jump or move depends on uninitialised value(s)" under every
# run_qt_* suite, innermost in five Qt functions -- text shaping and layout
# sizing, reached from QTableView::setModel, QLineEdit's text and a layout's
# activation -- and run_qt_backend and run_qt_notebook added three more: a
# line edit's text set through setProperty, an image scaled smoothly, and the
# raster engine filling a tool button's arrow (a function with no symbol, so
# its entries name the raster entry point beneath it instead). The probe
# reproduces every one with no gBASIC (as it does the five the gate of
# 2026-11-15 added, at the end of this file), and --track-origins placed each
# uninitialised value in a Qt allocation, never in gBASIC's. No invalid read or
# write was reported, by the probe or by gBASIC. On x86 neither reports
# anything. Whether it is Qt's s390x build or valgrind's s390x support (vector
# code is a known source of false positives there) was not separated.
#
# APPLIED ON s390x ONLY (tests/valgrind_tier.sh), and what that costs is said
# here rather than hidden: uninitialised TEXT that gBASIC handed to Qt would
# branch inside shapeText too, so on s390x these entries would hide it. x86,
# where Qt reports nothing, applies none of them and keeps that check.
#
# NARROW ON PURPOSE: the kind (Cond, never Addr or a leak) and the innermost
# frame, by exact mangled name. An entry matching "anything in libQt6" would
# also hide uninitialised data that WE passed in, which is the defect class the
# Qt valgrind tiers exist to catch. The entries were generated by valgrind
# (--gen-suppressions=all) from the probe, then cut to that innermost frame.

{
   qt-s390x-qtextengine-freememory-cond
   Memcheck:Cond
   fun:_ZN11QTextEngine10freeMemoryEv
   ...
}

{
   qt-s390x-qtextengine-shapetext-cond
   Memcheck:Cond
   fun:_ZNK11QTextEngine9shapeTextEi
   ...
}

{
   qt-s390x-qlayout-totalsizehint-cond
   Memcheck:Cond
   fun:_ZNK7QLayout13totalSizeHintEv
   ...
}

{
   qt-s390x-qlayout-totalminimumsize-cond
   Memcheck:Cond
   fun:_ZNK7QLayout16totalMinimumSizeEv
   ...
}

{
   qt-s390x-qlayout-totalmaximumsize-cond
   Memcheck:Cond
   fun:_ZNK7QLayout16totalMaximumSizeEv
   ...
}

{
   qt-s390x-qwidgetlinecontrol-finishchange-cond
   Memcheck:Cond
   fun:_ZN18QWidgetLineControl12finishChangeEibb
   ...
}

{
   qt-s390x-qtransform-multiply-cond
   Memcheck:Cond
   fun:_ZNK10QTransformmlERKS_
   ...
}

# no symbol inside libQt6Gui, so the frames below it say where it is: under the
# raster engine filling a polygon, and filling a vector path
{
   qt-s390x-raster-fillpolygon-cond
   Memcheck:Cond
   obj:*/libQt6Gui.so*
   obj:*/libQt6Gui.so*
   fun:_ZN18QRasterPaintEngine11fillPolygonEPK7QPointFiN12QPaintEngine15PolygonDrawModeE
   ...
}

{
   qt-s390x-raster-fillpath-cond
   Memcheck:Cond
   obj:*/libQt6Gui.so*
   obj:*/libQt6Gui.so*
   fun:_ZN18QRasterPaintEngine4fillERK11QVectorPathRK6QBrush
   ...
}

# MENU BARS, TAB BARS AND GRID LAYOUTS (run_qt_backend's menu, tabs and cells
# fixtures, 2026-11-14), reproduced by the probe's main window. --track-origins
# put each value in a heap block QMenuBar's or QGridLayout's own constructor
# allocated. Most are in unnamed functions, so each entry names the sizing
# method above them.
{
   qt-s390x-qtabbar-minimumsizehint-cond
   Memcheck:Cond
   fun:_ZNK7QTabBar15minimumSizeHintEv
   ...
}

