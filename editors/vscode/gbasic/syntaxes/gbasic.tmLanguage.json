{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "gBASIC",
  "scopeName": "source.gbasic",
  "comment": "The keyword, constant, word-operator and builtin lists are GENERATED from src/lexer.c and src/builtins.c by tools/sync_vscode_grammar.py; tests/run_editor_grammar.sh fails when they drift. Edit everything else by hand.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#modifiers" },
    { "include": "#strings" },
    { "include": "#definitions" },
    { "include": "#receiver" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gbasic",
          "match": "'.*$"
        }
      ]
    },
    "modifiers": {
      "comment": "A modifier clause: inline `{file}path` / `{USD}12.50`, or the assignment form `x {date}= s` / `x {split \",\"}= s`. A record literal always has a colon, so it never matches.",
      "patterns": [
        {
          "name": "storage.modifier.gbasic",
          "match": "\\{[^{}:\\n]*\\}(?=\\s*=)"
        },
        {
          "name": "storage.modifier.gbasic",
          "match": "\\{\\s*[A-Za-z_][\\w.]*\\s*\\}(?=\\S)"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.gbasic",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.unicode.gbasic",
          "match": "\\\\u\\{[0-9A-Fa-f]+\\}"
        },
        {
          "name": "constant.character.escape.gbasic",
          "match": "\\\\[nt\\\\\"]"
        },
        {
          "comment": "The parser keeps any other backslash pair as two characters and warns.",
          "name": "invalid.illegal.escape.gbasic",
          "match": "\\\\."
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(function|modifier)\\s+([A-Za-z_][\\w.]*)",
          "captures": {
            "1": { "name": "keyword.control.gbasic" },
            "2": { "name": "entity.name.function.gbasic" }
          }
        },
        {
          "match": "\\b(program|library|server)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.control.gbasic" },
            "2": { "name": "entity.name.type.gbasic" }
          }
        }
      ]
    },
    "receiver": {
      "patterns": [
        {
          "comment": "A method's receiver; an ordinary name everywhere else.",
          "name": "variable.language.this.gbasic",
          "match": "(?<![.\\w])this\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.gbasic",
          "match": "(?<![.\\w])(nothing|unknown|false|true)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "Not after a dot: `r.count`, `rule.as` and `x.end` are field names.",
          "name": "keyword.control.gbasic",
          "match": "(?<![.\\w])(intersecting|excluding|consider|continue|function|modifier|watchers|library|program|unwatch|without|export|return|break|error|gosub|print|spawn|until|watch|while|each|else|from|goto|load|next|step|stop|then|with|dim|end|for|new|use|as|do|if|in|on|to)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.gbasic",
          "match": "(?<![.\\w])(and|not|or)\\b"
        },
        {
          "name": "keyword.operator.gbasic",
          "match": "\\+=|-=|\\*=|/=|!>=|!<=|<=|>=|!=|!<|!>|[-+*/=<>]"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Only where a call can be: not after a dot (a field), and followed by `(`.",
          "name": "support.function.builtin.gbasic",
          "match": "(?<![.\\w])(library_collisions|password_hash_cost|base64url_decode|base64url_encode|aes_gcm_decrypt|aes_gcm_encrypt|ed25519_keypair|password_verify|atomic_replace|directory_name|ed25519_verify|json_encodable|source_outline|base32_decode|base32_encode|base64_decode|base64_encode|password_hash|ed25519_sign|random_bytes|remove_value|secure_token|zone_resolve|bytes_equal|correlation|deserialize|has_builtin|hmac_sha256|hmac_sha512|json_encode|starts_with|zone_offset|byte_count|byte_slice|covariance|file_mtime|from_bytes|from_epoch|hex_decode|hex_encode|is_boolean|is_nothing|is_unknown|list_files|percentile|random_int|read_lines|remove_dir|remove_key|take_first|try_decode|uncompress|byte_find|demonitor|ends_with|extension|file_name|file_size|file_type|from_zone|hmac_sha1|is_number|is_record|is_string|join_from|join_path|match_all|monotonic|overwrite|principal|pvariance|real_path|serialize|take_last|compress|contains|is_array|kurtosis|make_dir|quantile|skewness|to_bytes|variance|boolean|byte_at|compare|default|find_by|monitor|prepend|present|receive|replace|reverse|to_zone|append|decode|delete|encode|insert|lgamma|median|number|pstdev|random|record|remove|repeat|sha256|sha512|string|unique|values|array|count|epoch|first|floor|input|log10|lower|match|quote|range|regex|right|round|sleep|slice|split|stdev|upper|band|bnot|bxor|ceil|code|copy|erfc|exit|find|join|keys|last|left|mean|mode|move|rest|rotl|rotr|seed|self|send|sha1|sign|sort|sqrt|trim|type|abs|bor|chr|env|erf|exp|has|iqr|len|log|max|md5|mid|min|now|pow|shl|shr|sum)(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.gbasic",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "comment": "Scientific notation needs a digit after the e (`1e` is the number 1 beside a name).",
          "name": "constant.numeric.gbasic",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    }
  }
}
