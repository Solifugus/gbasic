{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((program|library|function|modifier|server|for|while|consider|with)\\b(?!.*\\bend\\b).*|if\\b.*\\bthen\\s*('.*)?|else\\b.*|do\\s*('.*)?)$",
    "decreaseIndentPattern": "^\\s*(end|else|next|until)\\b.*$"
  }
}
