on error goto next

print missing_value
if error then
    print error.message
    print error.line
    print error.column
    print error.code
    print error.source
    error.clear()
end if

x = 1 / 0
if error then
    print error.message
    error.clear()
end if

missing_function()
if error then
    print error.source
    error.clear()
end if

f (file)= "examples/no_such_error_file.txt"
print read(f)
if error then
    print error.source
    error.clear()
end if

on error goto failed
error "explicit failure"
print "not reached"

failed:
' Inside a `goto label` handler the details are still readable, but there is
' nothing UNACKNOWLEDGED to check: the jump was the acknowledgment. So bare
' `error` is false here while `error.message` still describes what happened.
print error.message
if error then
    print "NOT PRINTED -- the jump acknowledged it"
end if
error.clear()

function failer()
    x = 1 / 0
    return 99
end function

on error goto next
print failer()
if error then
    print "function error propagated"
    error.clear()
end if

lockfile (file)= "examples/tmp_error_lock_test.txt"
with lock(lockfile)
    error "locked failure"
end with
if error then
    print error.message
    error.clear()
end if

on error stop
print "done"
