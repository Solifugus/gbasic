modifier caseless for compare
    return compare(lower(left), operator, lower(right))
end modifier

modifier rounded(n) for compare
    return compare(round(left, n), operator, round(right, n))
end modifier

modifier rounded to(n) for compare
    return compare(round(left, n), operator, round(right, n))
end modifier

name = "Joe Barnes"

if name(caseless)= "joe barnes" then
    print "match"
end if

a = 1.234
b = 1.234

if a(rounded 2)= b then
    print "rounded match"
end if

if a(rounded to 2)= b then
    print "rounded multi-word match"
end if

places = 2
if a(rounded places)= b then
    print "rounded expression match"
end if
