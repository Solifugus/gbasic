== the continuation reports the formula it stands for ==
  C2  A2*$B$1
  C3  A3*$B$1
  C6  A6*$B$1

== relative shifts, absolute does not ==
  C2  A2*$B$1   = 20   cached 20
  C3  A3*$B$1   = 30   cached 30
  C4  A4*$B$1   = 40   cached 40
  C5  A5*$B$1   = 50   cached 50
  C6  A6*$B$1   = 60   cached 60

== a reference inside a STRING is text, not a reference ==
  D2  A2&"A1"
  D4  A4&"A1"
  D6  A6&"A1"

== mixed anchoring: each half independent ==
  E2  $A2+A$1
  E4  $A4+A$1
  E6  $A6+A$1

== both endpoints of a RANGE shift ==
  F2  SUM(A2:A3)
  F4  SUM(A4:A5)
  F6  SUM(A6:A7)

== the whole sheet agrees with its cached values ==
agree    = 25
disagree = 0

== recalc leaves them alone rather than overwriting with #VALUE! ==
evaluated = 25  changed = 0
C6 after  = 60
