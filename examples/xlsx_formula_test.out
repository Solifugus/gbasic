== evaluate a single formula against the sheet's cached values ==
Ledger B5  formula = SUM(B2:B3)
Ledger B5  computed= 1151.25
Ledger B5  cached  = 1151.25

== the oracle over a whole sheet ==
agree            = 17
disagree         = 0
volatile skipped = 1
unsupported      = 1

anything not agreeing is reported, never silently counted:
  volatile  B18  NOW()
      computed=#NAME?  cached=45870.5
  unsupported  B19  XLOOKUP(A1,A1:A3,A1:A3)
      computed=#NAME?  cached=10

== what each formula exercises ==
precedence   A1+A2*A3      = 20
parens      (A1+A2)*A3     = 35
div by zero  A1/0          = #DIV/0!
exponent     2^10          = 1024
unary minus -A2+1          = -3
percent      50%*A1        = 5
concat      "x"&A1         = x10
comparison   A1>A2         = true
IF                         = big
ROUND(2.5,0) half-away     = 3
SUM range                  = 16.5
AVERAGE range              = 5.5
COUNT skips text           = 3
IFERROR catches            = caught
