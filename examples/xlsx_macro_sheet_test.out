== the sheet list includes the partless sheets ==
  [Data]
  [Module1]
  [VBACode ]
  [After]

== the natural loop completes instead of raising ==
  Data -> 3 cells
  Module1 -> 0 cells
  VBACode  -> 0 cells
  After -> 1 cells
  total cells across every sheet = 4

== a partless sheet answers as an empty sheet ==
cells      = 0
cell A1    = unknown
evaluate   = unknown
dims.cells = false
check      = agree 0, disagree 0
recalc     = evaluated 0, changed 0

== the trailing space in the name is significant ==
cells in [VBACode ] = 0

== a name that is not in the workbook at all ==
sheet [Nope] present = false

== the real sheets are unaffected ==
Data B1 formula  = A1+A2
Data B1 computed = 7
After A1         = reached
