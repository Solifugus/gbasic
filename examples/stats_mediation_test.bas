    load stats from "../stdlib/stats.bas"

    x = [-0.319, -1.603, -1.535, -0.57, -0.217, 0.255, -0.149, 2.011, -0.097, 0.422, -0.225, -0.638, -0.016, 1.044, -1.085, -2.206, -0.951, 0.833, -1.0, 0.343, 1.546, 0.69, -2.046, 0.334, -0.641, -0.222, -1.23, 0.206, 0.821, -0.494, -1.409, -1.216, 1.734, -0.207, -0.733, 0.774, -0.777, -0.415, -1.146, 0.325, 0.001, 1.419, -0.149, -0.606, -1.186, 0.456, -0.838, -0.147, -0.682, 1.488, -1.095, -1.655, -0.024, -0.364, -0.483, 0.74, 0.611, 0.492, 1.793, -0.684, 1.054, -0.616, 0.437, -2.809, -0.654, 0.528, 0.933, -0.111, -1.121, 0.991, 1.631, -1.9, 0.062, 0.48, 0.38, -1.512, 0.289, 0.096, -0.293, 0.857]
    m = [0.555, -1.299, 0.351, -1.193, 1.554, -0.719, 1.098, 0.335, 0.425, 1.007, -0.631, 0.269, -0.73, 0.242, -0.467, -1.167, -0.142, 1.047, 1.657, 0.939, 1.048, 0.428, -1.222, 0.464, -0.855, 1.268, -0.491, -0.592, -0.123, 0.399, -0.548, -1.232, 0.302, -0.847, -0.115, 0.193, -1.791, 0.111, -2.763, -0.4, 1.216, 1.451, -1.905, -0.972, -1.476, 1.013, -0.251, 0.985, 0.134, 1.368, -1.552, -1.43, -0.447, -1.392, 0.769, 0.72, -1.181, 1.02, 0.323, 0.155, 0.096, -1.306, -0.729, -3.045, -1.047, -1.164, 0.878, -0.824, -0.955, 0.814, -0.13, -2.56, 1.384, -1.259, -0.555, -0.598, 0.45, -0.302, -1.26, 1.468]
    y = [0.555, -1.363, -0.551, -0.198, 1.594, -0.182, 0.527, 1.47, -1.552, 1.858, -1.278, -0.256, 0.045, 0.422, 0.223, -0.013, -0.415, 1.375, 0.853, 1.46, 1.143, 0.388, -1.613, 0.442, 0.029, -0.256, -0.19, -0.335, 0.028, -1.314, -1.533, -0.387, 0.398, 0.549, -1.063, -0.606, -1.055, -0.9, -1.532, 0.629, 0.915, 1.274, -1.737, -0.388, -0.881, 0.479, -0.594, -0.008, -0.068, 1.308, -1.371, -1.074, 0.193, -0.591, 0.231, 0.49, 0.268, 0.747, 1.671, 0.217, 1.697, -0.892, -0.209, -2.292, -0.489, -0.343, 0.927, 0.066, -0.851, -0.107, 0.014, -0.92, 0.295, -0.505, -0.305, -1.089, 0.356, 0.671, -0.686, 0.8]
    w = [1.89, 1.177, 1.189, 0.823, 1.167, 0.358, 1.251, 1.39, 1.301, 1.517, 1.287, 0.963, 1.006, 1.025, 0.001, 1.367, 1.552, 1.719, 1.929, 1.649, 1.48, 1.829, 0.827, 1.598, 1.803, 1.704, 0.863, 1.388, 0.843, 0.343, 0.362, 1.733, 0.334, 1.674, 0.6, 0.178, 0.105, 1.68, 1.559, 0.158, 0.021, 0.459, 0.624, 0.418, 0.595, 0.921, 1.203, 0.021, 0.86, 1.113, 1.814, 0.538, 1.72, 1.057, 0.246, 1.537, 1.927, 1.404, 1.71, 1.271, 0.976, 1.539, 1.152, 1.795, 0.781, 0.875, 0.465, 0.638, 0.613, 0.017, 1.012, 0.76, 1.458, 1.694, 0.734, 0.576, 0.886, 0.476, 0.129, 1.845]
