# Example environment for /etc/gbasic-site/site.env.
# Use a 0600 mode owned by root or the service manager.

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gbasic_site
PGUSER=gbasic_site

# Admin accounts are provisioned at setup time, not by the running service.
# Run setup.bas once with these set to create/update an admin login:
#   GBASIC_SITE_ADMIN_USER=replace-with-an-admin-username
#   GBASIC_SITE_ADMIN_PASSWORD=replace-with-a-strong-password
# The shared CSRF token below still protects anonymous public posting forms.
GBASIC_SITE_CSRF_TOKEN=replace-with-a-local-only-csrf-token

# Prefer a dedicated pgpass file for the service. If PGPASSWORD is used,
# keep this environment file readable only by trusted users.
PGPASSFILE=/etc/gbasic-site/pgpass
# PGPASSWORD=replace-with-a-secret
